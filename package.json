{
  "name": "cheng-pro",
  "version": "0.3.56",
  "description": "ChEng AIO — all-in-one marine chief engineer suite (Voyage Chief + Tank Chief)",
  "author": "ts0gs (Marvin C. Endozo)",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node server/index.js",
    "seed": "node scripts/seed-demo.js",
    "test": "node scripts/smoke-test.js && node scripts/test-license.js",
    "license-host": "node server/license/host.js",
    "desktop": "electron .",
    "dist:win": "electron-builder --win --publish never",
    "dist:linux": "electron-builder --linux --publish never",
    "android:prepare": "node scripts/prepare-android-www.js",
    "android:sync": "npm run android:prepare && npx cap sync android && node scripts/apply-android-print-bridge.js",
    "android:apk": "npm run android:sync && node scripts/android-release-prep.js && cd android && ./gradlew assembleRelease"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^9.0.6"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "license": "MIT"
}
